{
  "name": "@codesordinatestudio/social-auth",
  "version": "1.0.0",
  "description": "A configurable social authentication package for GitHub, Google, and Apple OAuth",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "oauth",
    "social-auth",
    "github",
    "google",
    "apple",
    "authentication",
    "bun",
    "nodejs"
  ],
  "author": "codesordinatestudio",
  "license": "MIT",
  "dependencies": {
    "@octokit/oauth-app": "^8.0.1",
    "@octokit/rest": "^22.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "googleapis": "^149.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ]
}
